# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# Supabase TRANSACTION pooler URL — port :6543, NOT the direct :5432.
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Gemini API — MUST have billing enabled (not free tier / 15 RPM). See docs/03-requirements.md.
GEMINI_API_KEY=

# LINE Messaging API (per-tenant tokens live in DB; these are for the first/dev OA).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Facebook / Meta (dev testing with own Page first).
META_APP_SECRET=
META_VERIFY_TOKEN=

# 32-byte AES key (base64) for encrypting channel tokens at rest. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Shared secret guarding the follow-up cron route (Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"). Leave blank to disable the check (dev).
CRON_SECRET=

# Super-admin password for the cross-tenant pages (/dashboard, /dashboard/new).
# Per-store staff log in per-tenant instead. Leave blank to leave it open (dev).
DASHBOARD_PASSWORD=

# Secret for signing per-user session cookies. Falls back to TOKEN_ENCRYPTION_KEY
# if unset, but set a distinct value in production.
SESSION_SECRET=

# Payment provider webhook secret (Authorization: Bearer <secret>). Leave blank
# in dev to skip verification. Real Omise/2C2P HMAC wires in per provider.
PAYMENT_WEBHOOK_SECRET=
