# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# Supabase TRANSACTION pooler URL — port :6543, NOT the direct :5432.
# Format: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Gemini API — MUST have billing enabled (not free tier / 15 RPM). See docs/03-requirements.md.
GEMINI_API_KEY=

# LINE Messaging API (per-tenant tokens live in DB; these are for the first/dev OA).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Facebook / Meta (dev testing with own Page first).
META_APP_SECRET=
META_VERIFY_TOKEN=
